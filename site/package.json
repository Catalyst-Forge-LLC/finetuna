{
	"name": "finetuna-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "node ../scripts/ensure-lease.mjs finetuna-site 5184 && filepress dev --host 0.0.0.0",
		"build": "filepress build",
		"preview": "filepress preview",
		"check": "filepress check",
		"ship": "pnpm build && wrangler pages deploy build --project-name=finetuna",
		"deploy": "pnpm ship"
	},
	"devDependencies": {
		"getfilepress": "^0.1.22",
		"wrangler": "^4.28.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"getfilepress",
			"workerd"
		]
	}
}
