{
  "name": "finetuna",
  "version": "1.1.2",
  "description": "Fit more context on your GPU — and keep it. VRAM-aware context tuner for Ollama.",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.30.1",
  "license": "MIT",
  "main": "finetuna.js",
  "bin": {
    "finetuna": "finetuna.js"
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Catalyst-Forge-LLC/finetuna.git"
  },
  "homepage": "https://finetuna.net",
  "bugs": {
    "url": "https://github.com/Catalyst-Forge-LLC/finetuna/issues"
  },
  "keywords": [
    "ollama",
    "vram",
    "gpu",
    "num_ctx",
    "context-length",
    "modelfile",
    "local-llm",
    "quantization",
    "llm-performance",
    "tuner",
    "cli"
  ],
  "files": [
    "finetuna.js",
    "lib",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "start": "node finetuna.js",
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "pnpm test",
    "ship": "pnpm --dir site run ship",
    "site:dev": "pnpm --dir site dev",
    "site:build": "pnpm --dir site run build",
    "site:deploy": "pnpm --dir site run ship"
  },
  "dependencies": {
    "ansi-colors": "^4.1.3",
    "enquirer": "^2.3.6"
  }
}
